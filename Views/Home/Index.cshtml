@{
    ViewData["Title"] = "Главная";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #1e1e2f 0%, #3a1c71 50%, #d76d77 100%);
        color: white;
        border-radius: 1.5rem;
        padding: 5rem 2rem;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .hero-btn {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hero-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }
</style>

<div class="container mt-5">
    <div class="hero-section">
        <h1 class="display-3 fw-bold mb-4">Погрузись в мир музыки</h1>
        <p class="lead mb-5">Твой личный каталог треков и альбомов. Управляй своей медиатекой прямо сейчас.</p>
        <a asp-controller="Track" asp-action="Index" class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold hero-btn text-dark">
            Открыть каталог треков
        </a>
    </div>
</div>