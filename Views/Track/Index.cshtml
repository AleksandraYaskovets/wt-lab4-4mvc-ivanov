@model IEnumerable<wt_lab4_4mvc_ivanov.Models.Track>

@{
    ViewData["Title"] = "Каталог треков";
}

<style>
    .track-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
        background: #ffffff;
    }
    .track-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
    }
    .track-header {
        background: linear-gradient(45deg, #2b2b2b, #4a4a4a);
        color: white;
        border-radius: 1rem 1rem 0 0;
        padding: 2rem 1rem;
        text-align: center;
        position: relative;
    }
    .track-header i {
        font-size: 3rem;
        opacity: 0.8;
    }
    .action-buttons .btn {
        border-radius: 50px;
    }
</style>

<!-- Подключаем иконки Bootstrap -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="fw-bold"><i class="bi bi-music-note-beamed text-primary"></i> Музыкальный каталог</h1>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Добавить трек
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm track-card rounded-4 overflow-hidden">
                    <div class="track-header">
                        <i class="bi bi-vinyl-fill"></i>
                    </div>
                    <div class="card-body text-center pt-4">
                        <h4 class="card-title fw-bold text-dark">@item.Title</h4>
                        <h6 class="card-subtitle mb-3 text-muted">
                            <i class="bi bi-person-fill"></i> @item.ArtistName
                        </h6>
                        <span class="badge bg-primary rounded-pill px-3 py-2">
                            <i class="bi bi-clock"></i> @item.DurationSeconds сек.
                        </span>
                    </div>
                    <div class="card-footer bg-white border-top-0 text-center pb-4 action-buttons">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm px-4 shadow-sm">
                            Подробнее <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>