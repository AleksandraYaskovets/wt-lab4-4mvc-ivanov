@model wt_lab4_4mvc_ivanov.Models.Track
@{
    ViewData["Title"] = "Информация о треке";
    var album = ViewBag.Album as wt_lab4_4mvc_ivanov.Models.Album;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-dark text-white p-5 text-center" style="background: linear-gradient(135deg, #232526, #414345) !important;">
                    <i class="bi bi-disc text-primary" style="font-size: 5rem; filter: drop-shadow(0 0 10px rgba(255,255,255,0.2));"></i>
                    <h2 class="mt-3 fw-bold">@Model.Title</h2>
                    <h5 class="text-light opacity-75">@Model.ArtistName</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item p-4 d-flex justify-content-between align-items-center">
                            <span class="text-muted"><i class="bi bi-hash"></i> ID трека</span>
                            <strong class="fs-5">@Model.Id</strong>
                        </li>
                        <li class="list-group-item p-4 d-flex justify-content-between align-items-center">
                            <span class="text-muted"><i class="bi bi-stopwatch"></i> Длительность</span>
                            <strong class="fs-5">@Model.DurationSeconds сек.</strong>
                        </li>
                        <li class="list-group-item p-4 d-flex justify-content-between align-items-center">
                            <span class="text-muted"><i class="bi bi-collection"></i> Альбом</span>
                            <strong class="fs-5 text-end">
                                @(album != null ? $"{album.Title} ({album.Year})" : "Неизвестен")
                            </strong>
                        </li>
                    </ul>
                </div>
                <div class="card-footer bg-white p-4 text-center border-0">
                    <a asp-action="Index" class="btn btn-dark rounded-pill px-5 py-2">
                        <i class="bi bi-arrow-left"></i> Назад к каталогу
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>