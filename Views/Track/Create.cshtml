@model wt_lab4_4mvc_ivanov.Models.Track
@{
    ViewData["Title"] = "Добавление трека";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white text-center py-4 rounded-top-4">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-cloud-arrow-up"></i> Новый трек</h3>
                </div>
                <div class="card-body p-5">
                    
                    <form asp-action="Create" method="post">
                        <div class="form-floating mb-4">
                            <input asp-for="Title" class="form-control rounded-3" id="floatingTitle" placeholder="Название" />
                            <label for="floatingTitle"><i class="bi bi-music-note"></i> Название трека</label>
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="ArtistName" class="form-control rounded-3" id="floatingArtist" placeholder="Исполнитель" />
                            <label for="floatingArtist"><i class="bi bi-mic"></i> Исполнитель</label>
                            <span asp-validation-for="ArtistName" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="DurationSeconds" type="number" class="form-control rounded-3" id="floatingDuration" placeholder="Длительность" />
                            <label for="floatingDuration"><i class="bi bi-stopwatch"></i> Длительность (сек)</label>
                            <span asp-validation-for="DurationSeconds" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AlbumId" class="form-label fw-bold"><i class="bi bi-collection-play"></i> Альбом</label>
                            <select asp-for="AlbumId" class="form-select form-select-lg rounded-3" asp-items="@(new SelectList(ViewBag.Albums, "Id", "Title"))">
                                <option value="">-- Выберите альбом --</option>
                            </select>
                        </div>

                        <div class="d-grid gap-3 mt-5">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                                <i class="bi bi-check-circle"></i> Сохранить трек
                            </button>
                            <a asp-action="Index" class="btn btn-light btn-lg rounded-pill text-muted">
                                Отмена
                            </a>
                        </div>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>
</div>